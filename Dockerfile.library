# Build a three-file authorization patch against the unchanged official runtime.
FROM zimengxiong/excalidash-backend@sha256:b77d43d9f70e414279e0babbbd59803086868e23148f071b8d65fb1e49bce836 AS original

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS compiler
WORKDIR /build
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --ignore-scripts --include=dev
COPY backend/tsconfig.json ./
COPY backend/src ./src
COPY --from=original /app/prisma_clients/sqlite/ ./src/generated/
RUN ./node_modules/.bin/tsc

FROM original
ARG PATCH_REVISION=unknown
LABEL org.opencontainers.image.version="0.6.7+library-read" \
      org.opencontainers.image.source="https://github.com/scv3lqq/ExcaliDash" \
      upstream.source="https://github.com/ZimengXiong/ExcaliDash" \
      org.opencontainers.image.base.name="zimengxiong/excalidash-backend:0.6.7" \
      org.opencontainers.image.base.digest="sha256:b77d43d9f70e414279e0babbbd59803086868e23148f071b8d65fb1e49bce836" \
      org.opencontainers.image.revision="${PATCH_REVISION}"
COPY --from=compiler --chown=1001:1001 --chmod=0444 /build/dist/auth/apiKeys.js /app/dist/auth/apiKeys.js
COPY --from=compiler --chown=1001:1001 --chmod=0444 /build/dist/auth/accountApiKeyRoutes.js /app/dist/auth/accountApiKeyRoutes.js
COPY --from=compiler --chown=1001:1001 --chmod=0444 /build/dist/middleware/auth.js /app/dist/middleware/auth.js
